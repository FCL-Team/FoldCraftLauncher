<?xml version="1.0" encoding="utf-8"?>
<!-- 中国大陆地区游戏内容下载受限提示：DownloadUI 内容层中替代页签与下载页面显示 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:visibility="gone">

    <com.tungsten.fcllibrary.component.view.FCLLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_container_white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:auto_linear_background_tint="true">

        <com.tungsten.fcllibrary.component.view.FCLImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_baseline_warning_24"
            app:use_theme_color="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/download_china"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/official_site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/download_china_official_site"
            app:ripple="true" />

    </com.tungsten.fcllibrary.component.view.FCLLinearLayout>

</FrameLayout>
