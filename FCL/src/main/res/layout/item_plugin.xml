<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/settings_plugin" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/sub_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/type_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            app:auto_text_tint="true" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.tungsten.fcllibrary.component.view.FCLSwitch
        android:id="@+id/switch_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/plugin_enable" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/config"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/plugin_env_config"
        app:auto_tint="true"
        app:no_padding="true"
        app:srcCompat="@drawable/ic_baseline_settings_24" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/uninstall"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/plugin_uninstall"
        app:auto_tint="true"
        app:no_padding="true"
        app:srcCompat="@drawable/ic_baseline_delete_24" />

</androidx.appcompat.widget.LinearLayoutCompat>
