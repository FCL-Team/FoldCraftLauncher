<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:padding="10dp">

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/account_skin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.skin.SkinViewer
        android:id="@+id/skin_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toTopOf="@id/positive"
        app:layout_constraintEnd_toStartOf="@id/scrollview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/positive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skin_view"
        app:layout_constraintTop_toBottomOf="@id/title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Skin Model Selection -->
            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/model_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/account_skin_model"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:use_theme_color="true" />

            <RadioGroup
                android:id="@+id/model_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/model_title">

                <com.tungsten.fcllibrary.component.view.FCLRadioButton
                    android:id="@+id/model_classic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/account_skin_model_classic"
                    app:text_use_theme_color="true" />

                <com.tungsten.fcllibrary.component.view.FCLRadioButton
                    android:id="@+id/model_slim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/account_skin_model_slim"
                    app:text_use_theme_color="true" />

            </RadioGroup>

            <!-- Upload from File -->
            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/skin_upload_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/account_skin_upload"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/model_group"
                app:use_theme_color="true" />

            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/skin_file_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/account_skin_no_file_selected"
                android:padding="4dp"
                android:singleLine="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/skin_upload_title" />

            <com.tungsten.fcllibrary.component.view.FCLImageButton
                android:id="@+id/skin_file_pick"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_baseline_edit_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/skin_upload_title"
                app:layout_constraintTop_toTopOf="@id/skin_upload_title"
                app:no_padding="true"
                app:use_theme_color="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/account_skin_upload_file"
                app:layout_constraintTop_toBottomOf="@id/skin_file_path" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/reset_skin_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/account_skin_reset"
                app:layout_constraintTop_toBottomOf="@id/upload" />

            <!-- Cape Management -->
            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/cape_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/account_cape_management"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/reset_skin_btn"
                app:use_theme_color="true" />

            <com.tungsten.fcllibrary.component.view.FCLLinearLayout
                android:id="@+id/cape_list_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/cape_title" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/hide_cape_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/account_cape_hide"
                app:layout_constraintTop_toBottomOf="@id/cape_list_layout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <com.tungsten.fcllibrary.component.view.FCLProgressBar
        android:id="@+id/progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/positive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
